# API base URL for frontend HTTP requests
VITE_API_URL=/api

# Optional API proxy target for local development
VITE_API_PROXY_TARGET=http://localhost:5000

# Optional frontend site URL used by meta tags and canonical URLs
# Must match the sitemap/robots.txt host exactly (www) or Google will see
# a canonical-vs-sitemap mismatch.
VITE_SITE_URL=https://www.locksmithajman.com
